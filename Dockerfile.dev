# syntax=docker/dockerfile:1

FROM node:22-alpine AS build

RUN apk add --no-cache git fontconfig font-dejavu \
  && fc-match "DejaVu Sans" | grep -q "DejaVuSans"

WORKDIR /app

ENV VITE_SITE_ENV=development

COPY package.json package-lock.json ./
RUN npm ci

# Copy the site before resolving the floating framework branch so a new site
# revision always refreshes the integration dependency instead of reusing an
# older Docker layer.
COPY index.html vite.config.js ./
COPY docs ./docs
COPY playground ./playground
COPY src ./src
COPY public ./public
COPY scripts ./scripts
COPY .framework-dev-ref ./

RUN npm run framework:dev
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]

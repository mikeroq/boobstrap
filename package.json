{
  "name": "boobstrap-site",
  "version": "0.1.0",
  "description": "The official landing page for the Boobstrap CSS framework.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "framework:dev": "node scripts/use-framework-dev.mjs",
    "framework:sync": "node scripts/use-framework-dev.mjs --sync",
    "build": "vite build && node scripts/generate-doc-route-pages.mjs",
    "preview": "vite preview",
    "test": "npm run build && node tests/smoke.mjs && node tests/dev-banner.mjs"
  },
  "keywords": [
    "boobstrap",
    "landing-page"
  ],
  "license": "MIT",
  "dependencies": {
    "@boobstrap/boobstrap": "0.3.1",
    "datatables.net": "3.0.1",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "^7.1.1"
  }
}
